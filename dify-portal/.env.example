# Compose and direct Django deployment use the same Host allowlist variable.
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
PORTAL_CSRF_TRUSTED_ORIGINS=

# Direct Django deployment reference (not applied by the Compose override).
# Django does not automatically load this file.
# Set DJANGO_SECRET_KEY, or provide .secret-key in the Portal root; do not commit real secrets.
DJANGO_DEBUG=false
DJANGO_CSRF_TRUSTED_ORIGINS=https://portal.example.com
PORTAL_DATA_DIR=/app/data
# Enable only when a trusted proxy overwrites X-Forwarded-Proto.
DJANGO_TRUST_PROXY=false
DJANGO_HSTS_SECONDS=0

# Experimental native Web App text-chat gateway; disabled until routing is verified.
# The original Dify listener must be private before enabling this.
DIFY_GATEWAY_ENABLED=false
DIFY_UPSTREAM_URL=http://127.0.0.1:8081
# Generate a long random value and configure the same value in Dify Nginx.
DIFY_AUTH_REQUEST_SECRET=replace-with-a-long-random-secret
