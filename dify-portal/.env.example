DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1]
DJANGO_CSRF_TRUSTED_ORIGINS=

# Local HTTP only. Production requires HTTPS and DJANGO_DEBUG=false.
DJANGO_DEBUG=true
# This integration uses a trusted Nginx proxy; do not expose Portal directly.
DJANGO_TRUST_PROXY=true
# Enable only after HTTPS deployment is verified.
DJANGO_HSTS_SECONDS=0